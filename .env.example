# Copy to .env.local and adjust paths for your machine.

# Absolute path to media OUTSIDE the repo (dev only).
# Put files in either:
#   $LOCAL_MEDIA_DIR/media/logo.png
#   $LOCAL_MEDIA_DIR/logo.png
LOCAL_MEDIA_DIR=/absolute/path/to/your/mesudar-media

# Leave empty for local /media/* serving via LOCAL_MEDIA_DIR.
# Production uses the R2 URL in .env.production.
NEXT_PUBLIC_MEDIA_BASE_URL=

# MongoDB (optional for local API routes)
# MONGODB_URI=
